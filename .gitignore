# ---- 构建产物 ----
build/
out/
cmake-build-*/
*.o
*.obj
*.ko
*.ilk
*.pdb
*.lib
*.a
*.so
*.dylib
*.dll
*.exe
*.exp
*.sys
*.pdb

# ---- Gradle / Android ----
.gradle/
local.properties

# ---- CMake ----
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
CTestTestfile.cmake
Testing/
install_manifest.txt
compile_commands.json

# ---- IDE / 编辑器 ----
# 注意：*.sln 与 *.vcxproj* 是 WDK 驱动工程的**源文件**，必须入库，
#       一旦忽略会导致 CI 报 MSB1009 "Project file does not exist"。
#       这里只忽略 IDE 产生的用户私有文件。
.vs/
.vscode/
.idea/
*.user
*.suo
*.sln.docstates
*.swp
*~

# ---- WDK / 驱动 ----
# 注意：*.inf/.inx 是安装信息**源文件**，必须入库，不可忽略。
#       编译产物落在目标平台目录与 obj 目录，用目录级规则排除。
objchk_*/
objfre_*/
obj/
**/x64/
**/ARM64/
**/Win32/
*.tmh
*.tracedata

# ---- NuGet / WDK ----
# driver/packages.config 是清单文件（入库），driver/packages/ 是还原产物
# （WDK x64 包单个 ~115MB，CI 每次还原，绝不入库）。
packages/

# ---- Python / 工具 ----
__pycache__/
*.pyc
.venv/

# ---- 日志与临时 ----
*.log
*.tmp
.DS_Store
Thumbs.db
