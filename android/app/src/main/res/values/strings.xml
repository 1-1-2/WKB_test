    <!-- 说明 -->
    <string name="usage_title">使用方式</string>
    <string name="usage_body">1. 手机与 PC 接入同一局域网；\n2. 点“启动服务”，等待状态变为“等待 PC 连接”；\n3. 在 PC 端 WO Mic 客户端填入上方手机地址；\n4. PC 端点开始推流后，手机自动开始采集并发送。</string>
    <string name="protocol_note">协议实现见 docs/protocol/womic-wifi-protocol-v1.md（双端实证）。</string>

