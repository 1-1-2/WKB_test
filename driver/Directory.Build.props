<Project>
  <!--
    WDK NuGet 构建接入（对齐 microsoft/Windows-driver-samples 的官方模式）。

    导入顺序很重要：WDK.x64 的 props 会把 WindowsSdkDir 指向包内 c 目录
    （含 km 头/库与 WindowsKernelModeDriver10.0 工具集），SDK.CPP 系列
    再补上 CRT/UCRT 的编译与库路径。三个 Import 均带 Exists 条件——
    没有 restore 过包时静默跳过，工程可正常打开（只是无法编译内核目标）。

    还原命令（CI 与本地一致）：
        nuget restore driver\packages.config -PackagesDirectory driver\packages

    版本变更时：同步改本文件里的三段版本号目录名、packages.config 的
    version、以及 CI 的 _NT_TARGET_VERSION（NTDDI 码）。
  -->
  <Import Project="packages\Microsoft.Windows.WDK.x64.10.0.28000.2526\build\native\Microsoft.Windows.WDK.x64.props" Condition="Exists('packages\Microsoft.Windows.WDK.x64.10.0.28000.2526\build\native\Microsoft.Windows.WDK.x64.props') and '$(Platform)' == 'x64'" />
  <Import Project="packages\Microsoft.Windows.SDK.CPP.x64.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.x64.props" Condition="Exists('packages\Microsoft.Windows.SDK.CPP.x64.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.x64.props') and '$(Platform)' == 'x64'" />
  <Import Project="packages\Microsoft.Windows.SDK.CPP.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.props" Condition="Exists('packages\Microsoft.Windows.SDK.CPP.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.props')" />

  <!--
    NuGet 布局的 INF 工具链路径修复（纯 NuGet 环境必需；有机器 WDK 时无害）。

    根因（CI run d89417f 实测）：WDK 的 WindowsDriver.x64.props 只把
    $(WDKBinRoot_x86)（= 包内 c\bin\<ver>\x86，其中只有 Inf2Cat.exe）
    加入 ExecutablePath；而 stampinf.exe / drvcat.exe 只存在于 x64 目录。
    纯 NuGet 环境下 PATH 里没有这些工具，StampInf 以
    "TRACKER : error TRK0005: Failed to locate: stampinf.exe" 失败。
    官方 samples 的 CI 靠 VS DevShell 中机器 WDK 的 PATH 兜底；本项目
    不依赖机器 WDK，因此显式给三个任务指定 ToolPath。

    实现要点（均经本地 dotnet msbuild 实测验证）：
    1. 用 glob 定位包内 x64/x86 工具目录，避免硬编码 bin 版本号——
       Directory.Build.props 求值早于 WDK 的 WindowsDriver.Default.props，
       那时 $(TargetPlatformVersion) 仍为空，$(WDKBinRoot_x64) 不可用；
    2. glob 与路径统一用正斜杠（MSBuild 在 Windows 上同样接受反/正斜杠，
       但 Unix 下反斜杠不被当作目录分隔符，正斜杠双平台安全）；
    3. 目录提取用项转换 @(Item->'%(RootDir)%(Directory)')——
       实测 %(Item.Metadata) 在 PropertyGroup 中不求值（会残留字面量
       "%(_MicLinkWdkStampInf.RootDir)..."），属性函数
       $([System.IO.Path]::GetDirectoryName(@(Item))) 返回空，均不可用；
    4. 未 restore 包时 WDK_NuGet 为空，本段整体跳过，不产生任何垃圾值。
  -->
  <ItemGroup Condition="'$(WDK_NuGet)' == 'true'">
    <_MicLinkWdkStampInf Include="$(WDKContentRoot)/bin/**/x64/stampinf.exe" />
    <_MicLinkWdkInf2Cat Include="$(WDKContentRoot)/bin/**/x86/Inf2Cat.exe" />
    <_MicLinkWdkDrvCat Include="$(WDKContentRoot)/bin/**/x64/drvcat.exe" />
  </ItemGroup>
  <PropertyGroup Condition="'$(WDK_NuGet)' == 'true'">
    <ExecutablePath Condition="'$(ExecutablePath)' != ''">$(ExecutablePath);@(_MicLinkWdkStampInf->'%(RootDir)%(Directory)')</ExecutablePath>
    <ExecutablePath Condition="'$(ExecutablePath)' == ''">@(_MicLinkWdkStampInf->'%(RootDir)%(Directory)')</ExecutablePath>
    <InfToolPath Condition="'$(InfToolPath)' == ''">@(_MicLinkWdkStampInf->'%(RootDir)%(Directory)')</InfToolPath>
    <Inf2CatToolPath Condition="'$(Inf2CatToolPath)' == ''">@(_MicLinkWdkInf2Cat->'%(RootDir)%(Directory)')</Inf2CatToolPath>
    <DrvCatToolPath Condition="'$(DrvCatToolPath)' == ''">@(_MicLinkWdkDrvCat->'%(RootDir)%(Directory)')</DrvCatToolPath>
  </PropertyGroup>
</Project>
