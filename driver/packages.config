<?xml version="1.0" encoding="utf-8"?>
<!--
  WDK NuGet 包清单（x64）。

  采用微软官方 Windows-driver-samples 的 CI 模式：不安装 WDK、不依赖
  winget、不做 SDK/WDK 版本桥接，构建前 nuget restore 本文件即可。
  包内自带完整 Windows Kits\10 目录树（km 头/库 + WindowsKernelModeDriver
  工具集 + InfVerif/stampinf 工具），由 driver/Directory.Build.props
  导入并把 WindowsSdkDir 指向包内 c 目录。

  版本对应关系：
    Microsoft.Windows.WDK.x64 10.0.28000.2526  -> WDK for Win11 25H2
    _NT_TARGET_VERSION = 0xA000012              -> 10.0.28000
  CI 与本地构建命令见 .github/workflows/build-driver.yml 与 docs/BUILD.md。
-->
<packages>
  <package id="Microsoft.Windows.SDK.CPP" version="10.0.28000.2526" targetFramework="native" />
  <package id="Microsoft.Windows.SDK.CPP.x64" version="10.0.28000.2526" targetFramework="native" />
  <package id="Microsoft.Windows.WDK.x64" version="10.0.28000.2526" targetFramework="native" />
</packages>
